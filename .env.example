# ==========================================
# HomeSync Backend Environment Template
# ==========================================

# Server Port
PORT=3000

# MongoDB Atlas Connection String
# Replace USERNAME and PASSWORD with your actual Atlas database user credentials
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.ed0icoo.mongodb.net/homesync?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_super_secret_key_here_at_least_32_characters

# CORS Client Origin
CLIENT_ORIGIN=http://localhost:3000
