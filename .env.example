# ==============================================================================
# HomeSync Backend Environment Template
# ==============================================================================
#
# FOR RENDER PRODUCTION DEPLOYMENT:
# Configure these variables in the Render Dashboard:
# -> Environment -> Add Environment Variable
#
# 1. NODE_ENV: Set to "production"
NODE_ENV=production

# 2. PORT: Render supplies PORT automatically (e.g. 10000). Leave unset on Render,
#    or set to 3000 for local testing.
PORT=3000

# 3. MONGODB_URI: Full MongoDB Atlas Cluster0 connection string targeting "homesync"
#    Replace USERNAME and PASSWORD with your Atlas database user credentials.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.ed0icoo.mongodb.net/homesync?retryWrites=true&w=majority

# 4. JWT_SECRET: Cryptographically random secret string for JWT authentication
JWT_SECRET=your_jwt_super_secret_key_here_at_least_32_characters

# 5. CLIENT_ORIGIN: Allowed frontend origin for CORS.
#    In production, set to your Vercel URL: https://YOUR-VERCEL-APP.vercel.app
#    Supports comma-separated list of origins (e.g. https://app.vercel.app, http://localhost:3000)
CLIENT_ORIGIN=https://YOUR-VERCEL-APP.vercel.app
